{
  "custom/idle-toggle": {
    "exec": "~/.config/waybar/scripts/idle-toggle.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{text}",
    "on-click": "if systemctl --user is-active --quiet hypridle.service; then systemctl --user stop hypridle.service; else systemctl --user start hypridle.service; fi",
  },
}
